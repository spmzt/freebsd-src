    leaf index {
      type uint32;
      nlx:attr 1;
      description
        "The PF_LIMIT_* limit.";
    }
    leaf limit {
      type uint32;
      nlx:attr 2;
    }
  }

  grouping begin-addrs-attrs {
    nlx:name-prefix "PF_BA_";
    description
      "A begin-addrs reply (pf_begin_addrs_types_t).";
    leaf ticket {
      type uint32;
      nlx:attr 1;
    }
  }

  grouping pool-addr-attrs {
    nlx:name-prefix "PF_PA_";
    description
      "An address of a pool (struct pf_pooladdr,
       pf_pool_addr_types_t).";
