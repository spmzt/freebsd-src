  grouping source-attrs {
    nlx:name-prefix "PF_SRC_";
    description
      "A source of a source limiter (pf_source_t).";
    leaf name {
      type string {
        length "0..15";
      }
      nlx:attr 1;
      description
        "Read: the limiter.";
    }
    leaf id {
      type uint32;
      nlx:attr 2;
      description
        "Read: the limiter.";
    }
    leaf af {
      type nlt:address-family;
      nlx:attr 3;
    }
    leaf rdomain {
      type uint32;
      nlx:attr 4;
    }
    leaf addr {
      type nlt:in6-addr;
      nlx:attr 5;
    }
    leaf inuse {
      type uint32;
      nlx:attr 6;
    }
    leaf admitted {
      type uint64;
      nlx:attr 7;
    }
    leaf hardlimited {
      type uint64;
      nlx:attr 8;
    }
    leaf ratelimited {
      type uint64;
      nlx:attr 9;
    }
    leaf limit {
      type uint32;
      nlx:attr 10;
    }
    leaf inet-prefix {
      type uint32;
      nlx:attr 11;
    }
    leaf inet6-prefix {
      type uint32;
      nlx:attr 12;
    }
  }

  grouping source-clear-attrs {
    nlx:name-prefix "PF_SC_";
    description
      "A source-clear request (pf_source_clear_t); the reply
       repeats the limiter's name as PF_SCL_NAME (2).";
    leaf name {
      type string {
        length "0..15";
      }
      nlx:attr 1;
    }
    leaf id {
      type uint32;
      nlx:attr 2;
    }
    leaf rdomain {
      type uint32;
      nlx:attr 3;
    }
    leaf af {
      type nlt:address-family;
      nlx:attr 4;
    }
    leaf addr {
      type nlt:in6-addr;
      nlx:attr 5;
    }
  }

  grouping ina-define-attrs {
    nlx:name-prefix "PF_ID_";
    description
      "An ina-define request and reply (pf_ina_define_t).";
    container table {
      nlx:attr 1;
      uses table-attrs;
    }
    leaf ticket {
      type uint32;
      nlx:attr 2;
    }
    leaf flags {
      type uint32;
      nlx:attr 3;
    }
    list addr {
      nlx:attr 4;
      description
        "The addresses, one nest each.";
      uses pfr-addr-attrs;
    }
    leaf nadd {
      type uint32;
      nlx:attr 5;
      description
        "Sent: the tables added.";
    }
    leaf naddr {
      type uint32;
      nlx:attr 6;
      description
        "Sent: the addresses added.";
    }
  }

  grouping osfp-attrs {
    nlx:name-prefix "PF_OFP_";
    description
      "An OS fingerprint (struct pf_osfp_ioctl, pf_osfp_t).";
    leaf idx {
      type uint32;
      nlx:attr 1;
      description
        "Read by osfp-get: which.";
    }
    leaf os-os {
      type uint32;
      nlx:attr 2;
    }
    leaf os-enflags {
      type uint32;
      nlx:attr 3;
    }
    leaf os-class {
      type string {
        length "0..31";
      }
      nlx:attr 4;
    }
    leaf os-version {
      type string {
        length "0..31";
      }
      nlx:attr 5;
    }
    leaf os-subtype {
      type string {
        length "0..31";
      }
      nlx:attr 6;
    }
    leaf tcpopts {
      type uint64;
      nlx:attr 7;
    }
    leaf wsize {
      type uint16;
      nlx:attr 8;
    }
    leaf psize {
      type uint16;
      nlx:attr 9;
    }
    leaf mss {
      type uint16;
      nlx:attr 10;
    }
    leaf flags {
      type uint16;
      nlx:attr 11;
    }
    leaf optcnt {
      type uint8;
      nlx:attr 12;
    }
    leaf wscale {
      type uint8;
      nlx:attr 13;
    }
    leaf ttl {
      type uint8;
      nlx:attr 14;
    }
  }

  grouping header {
    nlx:fixed-header genl:genlmsghdr;
    uses genl:genlmsghdr;
  }

  rpc getstates {
    nlx:cmd PFNL_CMD_GETSTATES;
    nlx:do;
    nlx:dump;
