    }
    leaf descr {
      type string {
        length "0..63";
      }
      nlx:attr 6;
    }
    leaf inuse {
      type uint32;
      nlx:attr 7;
    }
    leaf admitted {
      type uint64;
      nlx:attr 8;
    }
    leaf hardlimited {
      type uint64;
      nlx:attr 9;
    }
    leaf ratelimited {
      type uint64;
      nlx:attr 10;
    }
