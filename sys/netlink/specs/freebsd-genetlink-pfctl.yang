    leaf path {
      type string;
      nlx:attr 1;
      description
        "The anchor's path.";
    }
    leaf nr {
      type uint32;
      nlx:attr 2;
      description
        "Sent by get-rulesets: the child anchors; read by
         get-ruleset: which.";
    }
    leaf name {
      type string;
      nlx:attr 3;
      description
        "Sent by get-ruleset: the child anchor's name.";
    }
  }

  grouping srcnode-attrs {
    nlx:name-prefix "PF_SN_";
    description
      "A source node, a get-srcnodes reply (pf_srcnodes_types_t).";
    leaf addr {
      type nlt:in6-addr;
      nlx:attr 1;
    }
    leaf raddr {
      type nlt:in6-addr;
      nlx:attr 2;
    }
    leaf rule-nr {
      type uint32;
      nlx:attr 3;
    }
    leaf bytes-in {
      type uint64;
      nlx:attr 4;
    }
    leaf bytes-out {
      type uint64;
      nlx:attr 5;
    }
    leaf packets-in {
      type uint64;
      nlx:attr 6;
    }
    leaf packets-out {
      type uint64;
      nlx:attr 7;
    }
    leaf states {
      type uint32;
      nlx:attr 8;
    }
    leaf connections {
      type uint32;
      nlx:attr 9;
    }
    leaf af {
      type nlt:address-family;
      nlx:attr 10;
    }
    leaf rule-type {
      type uint8;
      nlx:attr 11;
    }
    leaf creation {
      type uint64;
      nlx:attr 12;
      units "seconds";
    }
    leaf expire {
      type uint64;
      nlx:attr 13;
      units "seconds";
    }
    container connection-rate {
      nlx:attr 14;
      uses threshold-attrs;
    }
    leaf raf {
      type nlt:address-family;
      nlx:attr 15;
    }
    leaf node-type {
      type uint8;
      nlx:attr 16;
      description
        "PF_SN_LIMIT, PF_SN_NAT or PF_SN_ROUTE.";
    }
  }

  grouping table-attrs {
    nlx:name-prefix "PF_T_";
    description
      "A table (struct pfr_table, pf_tables_t), in the table
       commands' requests and replies.";
    leaf anchor {
      type string;
      nlx:attr 1;
    }
    leaf name {
      type string {
        length "0..31";
      }
      nlx:attr 2;
    }
    leaf table-flags {
      type uint32;
      nlx:attr 3;
      description
        "PFR_TFLAG_* flags.";
    }
    leaf flags {
      type uint32;
      nlx:attr 4;
      description
        "PFR_FLAG_* flags of the request.";
    }
    leaf nbr-deleted {
      type uint32;
      nlx:attr 5;
      description
        "Sent: the tables, or addresses, deleted; 64 bits in a
         clr-addrs reply.";
    }
    leaf nbr-added {
      type uint32;
      nlx:attr 6;
      description
        "Sent: the tables added.";
    }
  }

  grouping tstats-attrs {
    nlx:name-prefix "PF_TS_";
    description
      "A table's statistics, a get-tstats reply (struct
       pfr_tstats, pf_tstats_t).";
    container table {
      nlx:attr 1;
      uses table-attrs;
    }
    leaf-list packets {
      type uint64;
      nlx:attr 2;
      nlx:array;
      description
        "[dir][op], PFR_DIR_MAX * PFR_OP_TABLE_MAX of them.";
    }
    leaf-list bytes {
      type uint64;
      nlx:attr 3;
      nlx:array;
    }
    leaf match {
      type uint64;
      nlx:attr 4;
    }
    leaf nomatch {
      type uint64;
      nlx:attr 5;
    }
    leaf tzero {
      type uint64;
      nlx:attr 6;
    }
    leaf cnt {
      type uint64;
      nlx:attr 7;
    }
    leaf-list refcnt {
      type uint64;
      nlx:attr 8;
      nlx:array;
      description
        "PFR_REFCNT_MAX of them.";
    }
    leaf nzero {
      type uint64;
      nlx:attr 9;
      description
        "Sent by clr-tstats: the tables zeroed.";
    }
  }

  grouping pfr-addr-attrs {
    nlx:name-prefix "PFR_A_";
    description
      "An address of a table (struct pfr_addr, pfr_addr_t).";
    leaf af {
      type nlt:address-family;
      nlx:attr 1;
      description
        "Read as 8 bits, sent as 32.";
    }
    leaf net {
      type uint8;
      nlx:attr 2;
      description
        "The prefix length.";
    }
    leaf not {
      type boolean;
      nlx:attr 3;
    }
    leaf addr {
      type nlt:in6-addr;
      nlx:attr 4;
    }
    leaf fback {
      type uint8;
      nlx:attr 5;
      description
        "Sent: the feedback, PFR_FB_*.";
    }
  }

  grouping table-addrs-attrs {
    nlx:name-prefix "PF_TA_";
    description
      "The table address commands' requests and replies
       (pf_table_addrs_t).";
    container table {
      nlx:attr 1;
      uses table-attrs;
    }
    list addr {
      nlx:attr 2;
      description
        "The addresses, one nest each, at most 256 in a request.";
      uses pfr-addr-attrs;
    }
    leaf flags {
      type uint32;
      nlx:attr 3;
      description
        "PFR_FLAG_* flags.";
    }
    leaf nbr-added {
      type uint32;
      nlx:attr 4;
    }
    leaf nbr-deleted {
      type uint32;
      nlx:attr 5;
    }
    leaf nbr-changed {
      type uint32;
      nlx:attr 6;
    }
    leaf addr-count {
      type uint32;
      nlx:attr 7;
      description
        "Sent by table-get-addr in its first message: the
         addresses to follow.";
    }
  }

  grouping astats-attrs {
    nlx:name-prefix "PF_AS_";
    description
      "An address's statistics (struct pfr_astats, pf_astats_t).";
    container addr {
      nlx:attr 1;
      uses pfr-addr-attrs;
    }
    leaf-list packets {
      type uint64;
      nlx:attr 2;
      nlx:array;
      description
        "[dir][op], PFR_DIR_MAX * PFR_OP_ADDR_MAX of them.";
    }
    leaf-list bytes {
      type uint64;
      nlx:attr 3;
      nlx:array;
    }
    leaf tzero {
      type nlt:time-t;
      nlx:attr 4;
    }
  }

  grouping table-astats-attrs {
    nlx:name-prefix "PF_TAS_";
    description
      "The table statistics commands' requests and replies
       (pf_table_astats_t).";
    container table {
      nlx:attr 1;
      uses table-attrs;
    }
    list astats {
      nlx:attr 2;
      description
        "Sent by table-get-astats: one address each.";
      uses astats-attrs;
    }
    leaf flags {
      type uint32;
      nlx:attr 3;
    }
    leaf astats-count {
      type uint32;
      nlx:attr 4;
      description
        "Sent first: the addresses to follow, or matched.";
    }
    leaf astats-zeroed {
      type uint32;
      nlx:attr 5;
    }
    list addr {
      nlx:attr 6;
      description
        "Sent by table-test-addrs: the addresses, with their
         feedback.";
      uses pfr-addr-attrs;
    }
  }

  grouping limit-rate-attrs {
    nlx:name-prefix "PF_LR_";
    description
