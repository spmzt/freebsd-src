        length "0..63";
      }
      nlx:attr 12;
    }
    leaf nentries {
      type uint32;
      nlx:attr 13;
    }
    leaf inuse {
      type uint32;
      nlx:attr 14;
    }
    leaf addr-allocs {
      type uint64;
      nlx:attr 15;
    }
    leaf addr-nomem {
      type uint64;
      nlx:attr 16;
    }
    leaf admitted {
      type uint64;
      nlx:attr 17;
    }
    leaf addrlimited {
      type uint64;
      nlx:attr 18;
    }
    leaf hardlimited {
      type uint64;
      nlx:attr 19;
    }
    leaf ratelimited {
      type uint64;
      nlx:attr 20;
    }
