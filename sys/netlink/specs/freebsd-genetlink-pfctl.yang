    }
    leaf ifname {
      type nlt:ifname;
      nlx:attr 2;
    }
  }

  grouping add-addr-attrs {
    nlx:name-prefix "PF_AA_";
    description
      "An add-addr, get-addrs or get-addr request and reply
       (pf_add_addr_types_t).";
    leaf action {
      type uint32;
      nlx:attr 1;
    }
    leaf ticket {
      type uint32;
      nlx:attr 2;
    }
    leaf nr {
      type uint32;
      nlx:attr 3;
    }
    leaf r-num {
      type uint32;
      nlx:attr 4;
    }
    leaf r-action {
      type uint8;
      nlx:attr 5;
    }
    leaf r-last {
      type uint8;
      nlx:attr 6;
    }
    leaf af {
      type nlt:address-family;
      nlx:attr 7;
    }
    leaf anchor {
      type string;
      nlx:attr 8;
    }
    container addr {
      nlx:attr 9;
      uses pool-addr-attrs;
    }
    leaf which {
      type uint32;
      nlx:attr 10;
      description
        "Which pool: PF_RDR, PF_NAT or PF_RT.";
    }
  }

  grouping rulesets-attrs {
    nlx:name-prefix "PF_RS_";
    description
      "A get-rulesets or get-ruleset request and reply
